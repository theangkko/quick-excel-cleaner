<Window x:Class="QuickExcelCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Excel Cleaner" Width="900" Height="650" MinWidth="760" MinHeight="520"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="OpenButton" Width="120" Height="34" Click="OpenButton_Click">Excel 파일 열기</Button>
                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <TextBlock x:Name="FileText" Text="Excel 파일을 여기에 끌어놓아도 됩니다." TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="Gray"
                               Text="지원: .xlsx / .xlsm · 원본은 수정하지 않습니다." />
                </StackPanel>
            </Grid>
        </Border>

        <GroupBox Grid.Row="1" Margin="0,16,0,12" Header="정리 옵션">
            <StackPanel Margin="10" Orientation="Horizontal">
                <CheckBox x:Name="UnusedStylesCheck" IsChecked="True" Margin="0,0,20,0">미사용 Style 정리</CheckBox>
                <CheckBox x:Name="DuplicateStylesCheck" IsChecked="True" Margin="0,0,20,0">중복 Style 병합</CheckBox>
                <CheckBox x:Name="TinyObjectsCheck" IsChecked="True">작은 객체 삭제</CheckBox>
                <TextBlock Margin="24,2,4,0">기준(px)</TextBlock>
                <TextBox x:Name="PixelThresholdText" Width="45" Text="2" />
            </StackPanel>
        </GroupBox>

        <DataGrid Grid.Row="2" x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="구분" Binding="{Binding Category}" Width="160" />
                <DataGridTextColumn Header="Sheet" Binding="{Binding Sheet}" Width="160" />
                <DataGridTextColumn Header="대상" Binding="{Binding Target}" Width="240" />
                <DataGridTextColumn Header="상세" Binding="{Binding Detail}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Text="Excel 파일을 선택하세요." />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="ScanButton" Width="120" Height="34" Margin="0,0,8,0" IsEnabled="False" Click="ScanButton_Click">검사 시작</Button>
                <Button x:Name="CleanButton" Width="120" Height="34" IsEnabled="False" Click="CleanButton_Click">정리 실행</Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
